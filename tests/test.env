# Test environment configuration
# Used by integration tests

# Database URL (update if your setup differs)
DATABASE_URL=postgres://rag_user:rag_password@localhost:15432/rag_chat
DB_MAX_CONNECTIONS=20             # Increased to handle concurrent indexing operations
DB_ACQUIRE_TIMEOUT_SECONDS=30     # Timeout for acquiring a connection from the pool

# Docling service URL
DOCLING_URL=http://localhost:5001
DOCLING_MODELS=DocLayNet,TableFormer,ibm-granite/granite-4.0-h-small-mlx-bf16

# LLM Configuration (LM Studio)
LLM_PROVIDER=openai
LLM_API_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=deepseek/deepseek-r1-0528-qwen3-8b

# Metadata Extraction LLM (use fast, non-reasoning model - already loaded)
# METADATA_LLM_MODEL removed
# METADATA_MAX_TOKENS removed

# Entity Extraction Model (SLIM NER for function calling)
ENTITY_EXTRACTION_MODEL=slim-ner-tool
ENTITY_EXTRACTION_ENABLED=true

# Timeout Configuration (in seconds)
LLM_TIMEOUT_SECONDS=300          # 5 minutes for LLM chat completions
EMBEDDING_TIMEOUT_SECONDS=120    # 2 minutes for embedding generation
EMBEDDING_API_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024        # Embedding vector dimensions (1024 for Qwen3-Embedding-0.6B)
DOCLING_TIMEOUT_SECONDS=180      # 3 minutes for document conversion

# Logging for tests
RUST_LOG=info
