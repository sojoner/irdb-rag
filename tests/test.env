# Test environment configuration
# Used by integration tests

# Database URL (update if your setup differs)
DATABASE_URL=postgres://rag_user:rag_password@localhost:15432/rag_chat
DB_MAX_CONNECTIONS=20             # Increased to handle concurrent indexing operations
DB_ACQUIRE_TIMEOUT_SECONDS=30     # Timeout for acquiring a connection from the pool

# Docling service URL
DOCLING_URL=http://localhost:5001
DOCLING_MODELS=DocLayNet,TableFormer,ibm-granite/granite-docling-258M-mlx-bf16

# LLM Configuration (OpenRouter)
LLM_PROVIDER=openai
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=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
LLM_MODEL=google/gemini-3-flash-preview

# Metadata Extraction LLM (OpenRouter - Gemini 3 Flash)
METADATA_LLM_PROVIDER=openai
METADATA_LLM_API_URL=https://openrouter.ai/api/v1
METADATA_LLM_API_KEY=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
METADATA_LLM_MODEL=google/gemini-3-flash-preview

# Entity Extraction / NER Model (OpenRouter - Gemini 3 Flash)
NER_LLM_PROVIDER=openai
NER_LLM_API_URL=https://openrouter.ai/api/v1
NER_LLM_API_KEY=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
NER_LLM_MODEL=google/gemini-3-flash-preview
ENTITY_EXTRACTION_ENABLED=true

# Timeout Configuration (in seconds)
LLM_TIMEOUT_SECONDS=300          # 5 minutes for LLM chat completions
EMBEDDING_TIMEOUT_SECONDS=120    # 2 minutes for embedding generation
EMBEDDING_API_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=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
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=4096         # qwen3-embedding-8b default output dimension (supports MRL for custom dimensions 32-4096)
DOCLING_TIMEOUT_SECONDS=180      # 3 minutes for document conversion

# Logging for tests
RUST_LOG=info
